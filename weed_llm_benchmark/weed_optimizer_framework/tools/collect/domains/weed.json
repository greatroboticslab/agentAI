  "intake_max_images": 50000,
  "intake_max_seconds": 21600,
  "approved_bytes": {},
  "floor_gb": null,
  "floor_su": null,
  "why": "section 6.6 limits (50 GB per source unless a person approves, 50 GB a day, the 200 GB proposal); a fetch keeps 20 GB free on its filesystem (the /ocean project quota itself is read by the autopilot, D27); floor_gb and floor_su are set by a person from the first wave (section 7.4); intake_max_images (2026-10-03): one intake batch takes at most this many images with a box, drawn round-robin over class sets, then capture groups, then images in a seeded order; the rest are deferred (decision 'deferred', over_intake_cap) and the next intake of the same fetch record takes them as continuation shards (collect.intake step 1b), until none is deferred. 40,000 at first; raised to 50,000 on 2026-10-03 to match Step 1's admit of one intake batch (inc2.step1_stream BATCH_CAP 50,000 rows), so each shard is admitted by one L17 job. Measured: the first zenodo_15808623 batch took 5,151 s for 40,000 of its 230,899 boxed images, about 19 images/s in the per-image loop plus about 45 min of fixed cost (hashing the 49.7 GB blob, extraction, normalising every label), so a 50,000-image shard over the kept tree fits the job's 8 h with room; earlier measurements were 0.15-0.66 s per image (PAGS8 614 images in 2 min 40 s, CottonWeedDet3 795 in 8 min 48 s); intake_max_seconds (2026-10-03): past 6 h of an intake job's 8 h the images not yet judged are deferred (over_intake_time), so a slow source commits what it judged instead of timing out with nothing, and the next shard takes them; every batch judges at least one image first, so a source whose fixed cost alone passes the budget still ends its shards",
  "disk_margin_bytes": 20000000000.0
 },
 "estimates": {
  "boxes_per_image": 2.0,
  "unknown_images": 500,
  "unknown_bytes": 2000000000.0,
  "text_target_share": 0.5,
  "deficit_bonus": 1.0,
  "why": "ranking priors only (expected target boxes per GB, D20): 2 boxes per image, a text-only source counts half its boxes as targets"
