   "filter": "download limit (location unverified)"
  },
  {
   "id": "S1",
   "name": "registry skip",
   "role": "registry",
   "unit": "source",
   "guard": false,
   "recoverable": "unknown_layout only",
   "depends_on": [],
   "filter": "verify._skip_reason and verify._layout: never_train, quarantine, user flag, layout"
  },
  {
   "id": "S2",
   "name": "read",
   "role": "read",
   "unit": "image",
   "guard": false,
   "recoverable": false,
   "depends_on": [
    "S1"
   ],
   "filter": "verify.read_source_label: no label, unreadable, no box, unmapped class; unhashable image"
  },
  {
   "id": "S3",
   "name": "exact_dup",
   "role": "dedup",
   "unit": "image",
   "guard": false,
   "recoverable": true,
   "depends_on": [
    "S2"
   ],
   "filter": "dHash-equal to an earlier pool image (slugs in sorted order; the first is kept)"
  },
  {
   "id": "S4",
   "name": "near_eval",
   "role": "guard",
   "unit": "image",
   "guard": true,
   "recoverable": false,
   "depends_on": [
    "S2"
   ],
   "filter": "within HOLDOUT_NEAR_DUP_BITS of a never-train image (C.NeverTrainGuard)"
  },
  {
   "id": "S5",
   "name": "cwd12_copy",
   "role": "guard",
   "unit": "image",
   "guard": true,
   "recoverable": false,
   "depends_on": [
    "S2"
   ],
   "filter": "within verify.CORE_COPY_BITS of a train_core image"
  },
  {
   "id": "S6",
   "name": "small boxes",
   "role": "size",
   "unit": "box",
   "guard": false,
   "recoverable": false,
   "depends_on": [
    "S5"
   ],
   "filter": "a side under semisup_labeler.MIN_BOX_PX"
  },
  {
   "id": "S7",
   "name": "species join",
   "role": "join",
   "unit": "box",
   "guard": false,
   "recoverable": true,
   "depends_on": [
    "S5"
   ],
   "filter": "verify.class_join (mega_trainer's v3.60.0 species join); a miss becomes OtherPlant"
  },
  {
   "id": "S7b",
   "name": "name status",
   "role": "name_status",
   "unit": "class",
   "guard": false,
   "recoverable": true,
   "depends_on": [
    "S7"
   ],
   "filter": "verify.other_name_status (v1); name_status_v2 via the taxonomy resolver (funnel)"
  },
  {
   "id": "S8b",
   "name": "OtherPlant training sample",
   "role": "reject_class_sample",
   "unit": "box",
   "guard": false,
   "recoverable": "not a discard",
   "depends_on": [
    "S7b"
   ],
   "filter": "verify._other_sample: N_OTHER crops, uniform over v1-eligible OtherPlant boxes"
  },
  {
   "id": "S8",
   "name": "verifier on target-labelled boxes",
   "role": "target_check",
   "unit": "box",
   "guard": false,
   "recoverable": true,
   "depends_on": [
    "S7",
    "S8b"
   ],
   "filter": "verify.verdicts: argmax = label, p >= tau, cos >= sigma"
  },
  {
   "id": "S9",
   "name": "verifier on OtherPlant-labelled boxes",
   "role": "other_check",
   "unit": "box",
   "guard": false,
   "recoverable": true,
   "depends_on": [
    "S7",
