# API keys
.roboflow_key

# Data & outputs (downloadable/regenerable)
downloads/
llm_labeled/
images/

# SLURM logs
slurm_*.out
slurm_*.err

# Model weights (large files)
*.pt

# Allow fine-tuned models we want to track
!weed_llm_benchmark/models/*.pt

# Results - ignore raw detection JSONs but keep evaluation results
weed_llm_benchmark/results/yolo_*.json
weed_llm_benchmark/results/eval_*.json
!weed_llm_benchmark/results/yolo_finetuned_*.json

# Training runs
runs/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# OS
.DS_Store
Thumbs.db

# multagent - exclude generated/vendored/large files
multagent/metagpt/
multagent/logs/
multagent/workspace/
multagent/.pytest_cache/
multagent/dashboard/frontend/node_modules/
multagent/dashboard/frontend/dist/

# IDE
.idea/
*.iml

# Cluster job output and staged supervision state (v3.25.0).
# These live at the REPO ROOT on the cluster only (Config.FRAMEWORK_DIR =
# <root>/results/framework); the tracked results/ trees under
# weed_llm_benchmark/ are untouched by these anchored patterns.
results/framework/_brain/
results/framework/_endpoints/
results/framework/llm_infer/
results/framework/model_deploy/
# Benchmark cases keep bundle.json + truth.json in git; the raw job artifacts
# they cite are large and may carry unscrubbed paths, so they stay out.
results/framework/supervision_bench/cases/*/artifacts/raw/
results/framework/*.out

# AppleDouble sidecars written when a mac writes to the shared filesystem
._*
